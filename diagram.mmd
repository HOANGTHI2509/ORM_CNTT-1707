flowchart LR
    %% Định dạng CSS
    classDef browser fill:#f9f9f9,stroke:#0055ff,stroke-width:2px,color:#333
    classDef odoo fill:#714B67,stroke:#5c3d54,stroke-width:3px,color:#fff
    classDef module fill:#e6f3ff,stroke:#0066cc,stroke-width:2px
    classDef db fill:#ffffe6,stroke:#ff9900,stroke-width:3px
    classDef external fill:#e6ffe6,stroke:#00cc00,stroke-width:2px,stroke-dasharray: 5 5

    subgraph Client ["Tang 1: Client"]
        A["Giao dien Nguoi dung<br/>Web Browser"]:::browser
    end

    subgraph OdooServer ["Tang 2: Application (Server Odoo ERP)"]
        direction LR
        B(("Odoo Core Engine Framework")):::odoo
        
        subgraph Modules ["Cac Phan he Xu Ly Logic Nghiêp vu"]
            direction TB
            M1["Module Nhan su<br/>(hr.employee)"]:::module
            M2["Module Phong hop<br/>(Dat phong/Duyet)"]:::module
            M3["Module Tai san<br/>(Vong doi & Bao tri)"]:::module
        end
        B --> Modules
    end

    subgraph Database ["Tang 3: Database"]
        DB[("Shared Database<br/>PostgreSQL")]:::db
    end

    subgraph External ["Tang 4: External API"]
        API[["Telegram API Server<br/>(Gateway Ting Ting)"]]:::external
    end

    A <-->|HTTP/REST| B
    
    M1 -.->|"Dong bo Muc 1"| M2
    M1 -.->|"Dong bo Muc 1"| M3
    M2 -.->|"Bao tri Auto (Muc 2)"| M3
    
    Modules <-->|"Odoo ORM"| DB
    
    M2 -...->|"Webhook Telegram (Muc 3)"| API
    M3 -...->|"Webhook Telegram (Muc 3)"| API
