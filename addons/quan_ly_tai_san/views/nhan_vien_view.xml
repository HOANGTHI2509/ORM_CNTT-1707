<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_nhan_vien_form_inherit_asset" model="ir.ui.view">
            <field name="name">hr.employee.form.inherit.asset</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="Lịch sử nhận/trả tài sản">
                        <field name="phieu_ban_giao_ids" readonly="1">
                            <tree>
                                <field name="ma_phieu"/>
                                <field name="loai_phieu"/>
                                <field name="nguoi_giao_id"/>
                                <field name="ngay_ban_giao"/>
                                <field name="trang_thai"/>
                            </tree>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
