<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron Job: Chúc mừng sinh nhật chạy lúc 8:00 sáng hàng ngày -->
        <record id="ir_cron_chuc_mung_sinh_nhat" model="ir.cron">
            <field name="name">Nhân sự: Chúc mừng sinh nhật</field>
            <field name="model_id" ref="model_nhan_vien"/>
            <field name="state">code</field>
            <field name="code">model.cron_chuc_mung_sinh_nhat()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="nextcall" eval="(DateTime.now().replace(hour=1, minute=0, second=0)).strftime('%Y-%m-%d %H:%M:%S')" />
        </record>
    </data>
</odoo>
