<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_employee_form_inherit_nhan_su" model="ir.ui.view">
            <field name="name">hr.employee.form.inherit.nhan_su</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet" position="before">
                    <header>
                        <button name="%(nhan_su.action_wizard_nhan_vien_ai)d" type="action" string="🪄 Trợ lý AI Tuyển Dụng" class="btn-primary" style="background-color: #00A09D; border-color: #00A09D; text-transform: uppercase; font-weight: bold;"/>
                    </header>
                </xpath>

                <!-- Thêm que_quan, ho_ten_dem, ten -->
                <xpath expr="//field[@name='category_ids']" position="after">
                    <group>
                        <group string="Lý lịch trích ngang">
                            <field name="ho_ten_dem" />
                            <field name="ten" />
                            <field name="gender" string="Giới tính" />
                            <field name="ngay_sinh" />
                            <field name="tuoi" />
                            <field name="so_nguoi_bang_tuoi" />
                        </group>
                        <group string="Công tác &amp; Liên hệ">
                            <field name="trang_thai_lam_viec"/>
                            <field name="phong_ban_id" string="Phòng ban" />
                            <field name="chuc_vu_id" />
                            <field name="so_dien_thoai" />
                            <field name="so_cccd" />
                            <field name="ngay_cap" />
                            <field name="que_quan" />
                        </group>
                    </group>
                </xpath>

                <xpath expr="//notebook" position="inside">
                    <page string="Lịch sử Hợp đồng lao động">
                        <field name="hop_dong_ids">
                            <tree>
                                <field name="so_hop_dong"/>
                                <field name="loai_hop_dong"/>
                                <field name="ngay_bat_dau"/>
                                <field name="ngay_ket_thuc"/>
                                <field name="trang_thai" widget="badge"
                                       decoration-success="trang_thai == 'hieu_luc'"
                                       decoration-danger="trang_thai == 'cham_dut'"
                                       decoration-warning="trang_thai == 'het_han'"
                                       decoration-info="trang_thai == 'nhap'"/>
                            </tree>
                        </field>
                    </page>
                    <page string="Quá trình công tác">
                        <field name="lich_su_cong_tac_ids">
                            <tree>
                                <field name="date_start"/>
                                <field name="date_end"/>
                                <field name="cong_ty"/>
                                <field name="don_vi_id"/>
                                <field name="chuc_vu_id"/>
                                <field name="loai_chuc_vu" widget="badge" decoration-info="loai_chuc_vu == 'Chính'" decoration-warning="loai_chuc_vu == 'Kiêm nhiệm'"/>
                            </tree>
                        </field>
                    </page>
                </xpath>

                <!-- Ẩn các trường thừa để tối giản form -->
                <xpath expr="//page[@name='personal_information']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='department_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='category_ids']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='coach_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//page[@name='hr_settings']//group[@name='identification_group']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//page[@name='hr_settings']//group[@name='payroll_group']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

            </field>
        </record>

        <record id="view_employee_tree_inherit_nhan_su" model="ir.ui.view">
            <field name="name">hr.employee.tree.inherit.nhan_su</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='department_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='job_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='parent_id']" position="before">
                    <field name="phong_ban_id" optional="show"/>
                    <field name="chuc_vu_id" optional="show"/>
                </xpath>
            </field>
        </record>

        <record id="action_nhan_vien" model="ir.actions.act_window">
            <field name="name">Nhân viên</field>
            <field name="res_model">hr.employee</field>
            <field name="view_mode">kanban,tree,form</field>
        </record>
    </data>
</odoo>