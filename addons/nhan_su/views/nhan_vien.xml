<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_employee_form_inherit_nhan_su" model="ir.ui.view">
            <field name="name">hr.employee.form.inherit.nhan_su</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <!-- Thêm ma_dinh_danh, que_quan, ho_ten_dem, ten -->
                <xpath expr="//field[@name='category_ids']" position="after">
                    <group>
                        <field name="ma_dinh_danh" />
                        <field name="ho_ten_dem" />
                        <field name="ten" />
                        <field name="que_quan" />
                        <field name="tuoi" />
                        <field name="so_nguoi_bang_tuoi" />
                        <field name="phong_ban_id" string="Phòng ban (Custom)" />
                    </group>
                </xpath>
                <xpath expr="//notebook" position="inside">
                    <page string="Lịch sử công tác">
                        <field name="lich_su_cong_tac_ids"/>
                    </page>
                    <page string="Chứng chỉ bằng cấp">
                        <field name="danh_sach_chung_chi_bang_cap_ids"/>
                    </page>
                    <page string="Hợp đồng lao động">
                        <field name="hop_dong_lao_dong_ids"/>
                    </page>
                </xpath>
            </field>
        </record>
        <record id="action_nhan_vien" model="ir.actions.act_window">
            <field name="name">Nhân viên</field>
            <field name="res_model">hr.employee</field>
            <field name="view_mode">kanban,tree,form</field>
        </record>
    </data>
</odoo>