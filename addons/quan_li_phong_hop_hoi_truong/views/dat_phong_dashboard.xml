<odoo>
    <data>

        <!-- View biểu đồ theo trạng thái -->
        <record id="view_dat_phong_graph_an_toan" model="ir.ui.view">
            <field name="name">dat.phong.graph.an.toan</field>
            <field name="model">dat_phong</field>
            <field name="arch" type="xml">
                <graph string="Thống kê chi tiết" type="bar">
                    <field name="trang_thai" type="row"/>
                    <field name="so_luong" type="measure" operator="sum"/>
                </graph>
            </field>
        </record>

        <!-- Action -->
        <record id="action_dat_phong_dashboard" model="ir.actions.act_window">
            <field name="name">📊 Dashboard Trạng Thái Mượn Phòng</field>
            <field name="res_model">dat_phong</field>
            <field name="view_mode">graph</field>
            <field name="view_id" ref="view_dat_phong_graph_an_toan"/>
        </record>

    </data>
</odoo>
