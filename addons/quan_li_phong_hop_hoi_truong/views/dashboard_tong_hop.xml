<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dashboard_tong_hop_board_v3" model="ir.ui.view">
        <field name="name">board.tong.hop.form.v3</field>
        <field name="model">board.board</field>
        <field name="arch" type="xml">
            <form string="Bảng Tổng Hợp">
                <board style="2-1">
                    <column>
                        <!-- Danh sách -->
                        <action string="Yêu cầu Cần Duyệt Gấp" name="%(quan_li_phong_hop_hoi_truong.action_dashboard_dat_phong_cho_duyet)d"/>
                        <!-- Biểu đồ trạng thái -->
                        <action string="Tình trạng Xử lý Yêu cầu (Bar)" name="%(quan_li_phong_hop_hoi_truong.action_dat_phong_dashboard)d"/>
                    </column>
                    <column>
                        <!-- Biểu đồ phân bổ phòng -->
                        <action string="Mức độ sử dụng các Cơ sở (Pie)" name="%(quan_li_phong_hop_hoi_truong.action_dashboard_dat_phong_phong)d"/>
                        <!-- Danh sách Biên bản phạt -->
                        <action string="Biên Bản Chờ Phê Duyệt" name="%(quan_li_phong_hop_hoi_truong.action_dashboard_bien_ban_cho_duyet)d"/>
                    </column>
                </board>
            </form>
        </field>
    </record>

    <record id="action_dashboard_tong_hop_v3" model="ir.actions.act_window">
        <field name="name">Đại Sảnh (Dashboard)</field>
        <field name="res_model">board.board</field>
        <field name="view_mode">form</field>
        <field name="usage">menu</field>
        <field name="view_id" ref="view_dashboard_tong_hop_board_v3"/>
    </record>
</odoo>
