<odoo>
    <data>
        <!-- Calendar View -->
        <record id="view_dat_phong_calendar" model="ir.ui.view">
            <field name="name">dat_phong_calendar</field>
            <field name="model">dat_phong</field>
            <field name="arch" type="xml">
                <calendar string="Lịch Đặt Phòng"
                          date_start="thoi_gian_muon_du_kien"
                          date_stop="thoi_gian_tra_du_kien"
                          color="phong_id"
                          mode="month"
                          quick_add="False">
                    <field name="nguoi_muon_id"/>
                    <field name="phong_id"/>
                    <field name="trang_thai"/>
                </calendar>
            </field>
        </record>

        <!-- Form View - Đăng ký mượn phòng -->
        <record id="view_dat_phong_form" model="ir.ui.view">
            <field name="name">dat_phong_form</field>
            <field name="model">dat_phong</field>
            <field name="arch" type="xml">
                <form string="📋 Chi tiết Đăng Ký Mượn Phòng">
                    <header>
                        <button name="%(quan_li_phong_hop_hoi_truong.action_report_phieu_muon_phong)d" type="action" string="🖨️ In Phiếu" class="oe_highlight"/>
                        <button name="xac_nhan_duyet_phong" string="✅ Duyệt" type="object" class="btn-primary"
                            attrs="{'invisible': [('trang_thai', '!=', 'chờ_duyệt')]}"/>
                        <button name="xac_nhan_duyet_cap_2" string="⭐ Lãnh đạo Duyệt" type="object" class="btn-warning"
                            attrs="{'invisible': [('trang_thai', '!=', 'cho_duyet_cap_2')]}"/>
                        <button name="huy_muon_phong" string="❌ Hủy" type="object" class="btn-danger"
                            attrs="{'invisible': [('trang_thai', '!=', 'chờ_duyệt')]}"/>
                        <button name="bat_dau_su_dung" string="🚀 Bắt đầu" type="object" class="btn-success"
                            attrs="{'invisible': [('trang_thai', '!=', 'đã_duyệt')]}"/>
                        <button name="huy_da_duyet" string="🛑 Hủy" type="object" class="btn-warning"
                            attrs="{'invisible': [('trang_thai', '!=', 'đã_duyệt')]}"/>
                        <button name="tra_phong" string="🏠 Trả phòng" type="object" class="btn-info"
                            attrs="{'invisible': [('trang_thai', '!=', 'đang_sử_dụng')]}"/>
                        <field name="trang_thai" widget="statusbar" statusbar_visible="chờ_duyệt,đã_duyệt,đang_sử_dụng"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="ma_phieu" readonly="1"/>
                            </h1>
                        </div>
                        <group col="2">
                            <group>
                                <separator string="🏷 Thông tin chung" colspan="2"/>
                                <field name="phong_id"/>
                                <field name="nguoi_muon_id"/>
                                <field name="email"/>
                                <field name="tai_san_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                <field name="dich_vu_ids" widget="many2many_checkboxes"/>
                            </group>
                        </group>

                        <group col="2">
                            <separator string="📅 Thời gian Mượn Trả" colspan="2"/>
                            <field name="thoi_gian_muon_du_kien" string="⏳ Mượn dự kiến"/>
                            <field name="thoi_gian_tra_du_kien" string="📆 Trả dự kiến"/>
                            <field name="kieu_lap"/>
                            <field name="ngay_ket_thuc_lap" attrs="{'invisible': [('kieu_lap', '=', 'khong_lap')], 'required': [('kieu_lap', '!=', 'khong_lap')]}"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Tree View - Danh sách Đăng ký mượn phòng -->
        <record id="view_dat_phong_tree" model="ir.ui.view">
            <field name="name">dat_phong_tree</field>
            <field name="model">dat_phong</field>
            <field name="priority">1</field>
            <field name="arch" type="xml">
                <tree string="📋 Danh sách Đăng Ký Mượn Phòng">
                    <field name="ma_phieu" string="Mã phiếu"/>
                    <field name="phong_id" string="🏢 Phòng họp"/>
                    <field name="nguoi_muon_id" string="👤 Người mượn"/>
                    <field name="thoi_gian_muon_du_kien" string="⏳ Mượn dự kiến"/>
                    <field name="thoi_gian_tra_du_kien" string="📆 Trả dự kiến"/>
                    <field name="trang_thai" string="📌 Trạng thái"
                           decoration-muted="trang_thai=='đã_hủy'"
                           decoration-danger="trang_thai=='đang_sử_dụng'"
                           decoration-info="trang_thai=='đã_duyệt'"
                           decoration-success="trang_thai=='chờ_duyệt'"/>
                    
                    <!-- Nút hành động -->
                    <button name="xac_nhan_duyet_phong" string="✅ Duyệt" type="object" class="btn-primary"
                        attrs="{'invisible': [('trang_thai', '!=', 'chờ_duyệt')]}"/>
                    
                    <button name="xac_nhan_duyet_cap_2" string="⭐ Lãnh đạo Duyệt" type="object" class="btn-warning"
                        attrs="{'invisible': [('trang_thai', '!=', 'cho_duyet_cap_2')]}"/>

                    <button name="huy_muon_phong" string="❌ Hủy" type="object" class="btn-danger"
                        attrs="{'invisible': [('trang_thai', '!=', 'chờ_duyệt')]}"/>
                    <button name="bat_dau_su_dung" string="🚀 Bắt đầu" type="object" class="btn-success"
                        attrs="{'invisible': [('trang_thai', '!=', 'đã_duyệt')]}"/>
                    <button name="huy_da_duyet" string="🛑 Hủy" type="object" class="btn-warning"
                        attrs="{'invisible': [('trang_thai', '!=', 'đã_duyệt')]}"/>
                    <button name="tra_phong" string="🏠 Trả phòng" type="object" class="btn-info"
                        attrs="{'invisible': [('trang_thai', '!=', 'đang_sử_dụng')]}"/>
                </tree>
            </field>
        </record>

        <!-- Search View - Bộ lọc tìm kiếm -->
        <record model="ir.ui.view" id="dat_phong_search">
            <field name="model">dat_phong</field>
            <field name="arch" type="xml">
                <search string="🔍 Tìm kiếm Đăng Ký Mượn Phòng">
                    <field name="ma_phieu" string="Mã phiếu"/>
                    <field name="phong_id" string="🏢 Phòng họp"/>
                    <field name="nguoi_muon_id" string="👤 Người mượn"/>
                    <field name="thoi_gian_muon_du_kien" string="⏳ Mượn dự kiến"/>
                    <field name="thoi_gian_tra_du_kien" string="📆 Trả dự kiến"/>
                    <field name="trang_thai" string="📌 Trạng thái"/>
                </search>
            </field>
        </record>

        <!-- Kanban View - Đơn đặt phòng -->
        <record id="view_dat_phong_kanban" model="ir.ui.view">
            <field name="name">dat_phong.kanban</field>
            <field name="model">dat_phong</field>
            <field name="arch" type="xml">
                <kanban default_group_by="trang_thai" class="o_kanban_small_column" sample="1">
                    <field name="ma_phieu"/>
                    <field name="phong_id"/>
                    <field name="nguoi_muon_id"/>
                    <field name="thoi_gian_muon_du_kien"/>
                    <field name="thoi_gian_tra_du_kien"/>
                    <field name="trang_thai"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_global_click">
                                <div class="o_kanban_record_title">
                                    <strong><field name="ma_phieu"/></strong> - <span><field name="phong_id"/></span>
                                </div>
                                <div class="o_kanban_record_subtitle">
                                    <span>Mượn: <field name="thoi_gian_muon_du_kien" widget="datetime"/></span><br/>
                                    <span>Trả: <field name="thoi_gian_tra_du_kien" widget="datetime"/></span>
                                </div>
                                <div class="o_kanban_record_bottom mt-2">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="trang_thai" widget="label_selection" options="{'classes': {'chờ_duyệt': 'info', 'cho_duyet_cap_2': 'warning', 'đã_duyệt': 'primary', 'đang_sử_dụng': 'success', 'đã_hủy': 'danger', 'đã_trả': 'secondary'}}"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <img t-att-src="kanban_image('hr.employee', 'image_128', record.nguoi_muon_id.raw_value)" class="oe_kanban_avatar rounded-circle"/>
                                        <span class="ml-1"><field name="nguoi_muon_id"/></span>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Action - Danh sách tất cả đăng ký -->
        <record id="action_dat_phong" model="ir.actions.act_window">
            <field name="name">📋 Danh sách Đăng Ký Mượn Phòng</field>
            <field name="res_model">dat_phong</field>
            <field name="view_mode">kanban,tree,form,calendar</field>
            <field name="search_view_id" ref="dat_phong_search"/>
        </record>

        <!-- Action - Danh sách Chờ duyệt -->
        <record id="action_dat_phong_cho_duyet" model="ir.actions.act_window">
            <field name="name">📋 Danh sách Chờ Duyệt</field>
            <field name="res_model">dat_phong</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="search_view_id" ref="dat_phong_search"/>
            <field name="domain">[("trang_thai", "in", ["chờ_duyệt", "cho_duyet_cap_2"])]</field>
        </record>

        <!-- Action - Danh sách Đã duyệt -->
        <record id="action_dat_phong_da_duyet" model="ir.actions.act_window">
            <field name="name">📋 Danh sách Đã Duyệt</field>
            <field name="res_model">dat_phong</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="search_view_id" ref="dat_phong_search"/>
            <field name="domain">[("trang_thai", "=", "đã_duyệt")]</field>
        </record>

        <!-- Action - Danh sách Phòng Đang sử dụng -->
        <record id="action_dat_phong_dang_su_dung" model="ir.actions.act_window">
            <field name="name">📋 Danh sách Phòng Đang Sử Dụng</field>
            <field name="res_model">dat_phong</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="search_view_id" ref="dat_phong_search"/>
            <field name="domain">[("trang_thai", "=", "đang_sử_dụng")]</field>
        </record>

        <!-- Action - Danh sách Đã hủy -->
        <record id="action_dat_phong_da_huy" model="ir.actions.act_window">
            <field name="name">📋 Danh sách Đã Hủy</field>
            <field name="res_model">dat_phong</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="search_view_id" ref="dat_phong_search"/>
            <field name="domain">[("trang_thai", "=", "đã_hủy")]</field>
        </record>
    </data>
</odoo>
