<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron Job: Nhắc nhở họp trước 15 phút (Chạy mỗi 15 phút) -->
        <record id="ir_cron_nhac_nho_hop" model="ir.cron">
            <field name="name">Phòng họp: Nhắc nhở trước giờ họp</field>
            <field name="model_id" ref="model_dat_phong"/>
            <field name="state">code</field>
            <field name="code">model.cron_nhac_nho_hop()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="nextcall" eval="(DateTime.now()).strftime('%Y-%m-%d %H:%M:%S')" />
        </record>

        <!-- Cron Job: Nhắc trả phòng (Chạy mỗi 30 phút) -->
        <record id="ir_cron_nhac_tra_phong" model="ir.cron">
            <field name="name">Phòng họp: Nhắc trả phòng</field>
            <field name="model_id" ref="model_dat_phong"/>
            <field name="state">code</field>
            <field name="code">model.cron_nhac_tra_phong()</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="nextcall" eval="(DateTime.now()).strftime('%Y-%m-%d %H:%M:%S')" />
        </record>
    </data>
</odoo>
